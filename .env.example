# Copy to .env for local dev. .env is gitignored — never commit real values.

# Which backend utils-backend.js talks to. Defaults to the current Google
# Apps Script backend; only flip this locally while testing Phase 4's
# Supabase integration. Production stays "gas" until a deliberate cutover.
VITE_BACKEND=gas

# Supabase project (studyfeed). Anon/publishable key only — it's safe to
# expose client-side, every table is gated by RLS. Never put the
# service_role key here or anywhere else reachable from the frontend.
VITE_SUPABASE_URL=https://yrzqnlhbawzuzlrrocfd.supabase.co
VITE_SUPABASE_ANON_KEY=
